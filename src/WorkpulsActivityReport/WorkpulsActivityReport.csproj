<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>WorkpulsActivityReport</AssemblyName>
    <RootNamespace>WorkpulsActivityReport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Report\template.html" LogicalName="template.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WorkpulsActivityReport.Tests" />
  </ItemGroup>

</Project>
